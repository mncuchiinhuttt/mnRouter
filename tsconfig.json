{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["bun-types"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@db": ["src/server/db/index.ts"],
			"@db/*": ["src/server/db/*"],
			"@services/*": ["src/server/services/*"],
			"@repositories/*": ["src/server/repositories/*"],
			"@gateway/*": ["src/server/gateway/*"],
			"@auth/*": ["src/server/auth/*"],
			"@routes/*": ["src/server/routes/*"],
			"@limits/*": ["src/server/limits/*"],
			"@usage/*": ["src/server/usage/*"],
			"@shared/*": ["src/shared/*"],
			"@server/*": ["src/server/*"],
			"@web/*": ["web/src/*"]
		}
	},
	"include": ["src", "web/src", "scripts", "test", "vite.config.ts", "drizzle.config.ts"]
}
