# --- Core ---
PORT=8787
APP_URL=http://localhost:5173
# Neon pooled connection string
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/mnrouter?sslmode=require
# random 32 bytes hex — used to sign nothing sensitive, but rotate to kill sessions
SESSION_SECRET=change-me-to-random-hex

# --- Mail (iCloud SMTP, same approach as TestAppleMail) ---
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=your-icloud@icloud.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="MNRouter <system@mncuchiinhuttt.dev>"

# --- OpenCode Zen fallback token (optional) ---
OPENCODE_ZEN_TOKEN=your-token-here

# --- Bootstrap: tạo admin đầu tiên nếu DB rỗng (chạy: pnpm bootstrap <email>) ---
ADMIN_EMAIL=admin@mncuchiinhuttt.dev
