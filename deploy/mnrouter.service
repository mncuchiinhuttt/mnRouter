[Unit]
Description=MNRouter — internal AI gateway (Bun runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mnrouter
Group=mnrouter
WorkingDirectory=/opt/mnrouter
EnvironmentFile=/etc/mnrouter.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/bun src/server/index.ts
Restart=always
RestartSec=3
# Wyse 3040 yếu — chặn RAM để không giết cả hệ thống (bun idle ~60-100MB)
MemoryMax=512M
MemoryHigh=384M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mnrouter

[Install]
WantedBy=multi-user.target
