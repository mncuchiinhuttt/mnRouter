[Unit]
Description=MNRouter - internal AI gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mncuchiinhuttt
WorkingDirectory=/opt/mnrouter
EnvironmentFile=-/etc/mnrouter.env
Environment=NODE_ENV=production
Environment=DATABASE_URL=/opt/mnrouter/data/mnrouter.db
ExecStart=/opt/mnrouter/mnrouter
Restart=always
RestartSec=3
# Wyse 3040 yếu — chặn RAM tối đa để không bao giờ bị tràn (app chỉ tốn ~60-80MB)
MemoryMax=512M
MemoryHigh=384M

[Install]
WantedBy=multi-user.target
